#!/usr/bin/env python3

import os
import sys
from pathlib import Path


def notify(path: str) -> None:
    with Path(path).open("wb", buffering=0) as checkpoint:
        checkpoint.write(b"1")


def wait(path: str) -> None:
    with Path(path).open("rb", buffering=0) as checkpoint:
        assert checkpoint.read(1) == b"1"


def resolve() -> None:
    libraries = os.environ["MCP_CONSOLE_TEST_IR_LIBRARIES"].split(os.pathsep)
    counter = Path(os.environ["MCP_CONSOLE_TEST_IR_COUNTER"])
    index = int(counter.read_text(encoding="utf-8")) if counter.exists() else 0
    assert index < len(libraries), (index, libraries)
    gate_index = os.environ.get("MCP_CONSOLE_TEST_IR_GATE_INDEX")
    if gate_index is None or index == int(gate_index):
        if started := os.environ.get("MCP_CONSOLE_TEST_IR_STARTED"):
            notify(started)
        if release := os.environ.get("MCP_CONSOLE_TEST_IR_RELEASE"):
            wait(release)
    counter.write_text(str(index + 1), encoding="utf-8")
    print(libraries[index], end="")


def main() -> None:
    if sys.argv[1:] == ["--version"]:
        print("ir 0.4.0")
        return
    assert sys.argv[1] == "run", sys.argv
    resolve()


if __name__ == "__main__":
    main()
