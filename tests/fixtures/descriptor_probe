#!/usr/bin/env python3

from __future__ import annotations

import errno
import json
import os
import socket
import sys
from typing import Any

INHERITED_FD_ENV = "MCP_CONSOLE_TEST_INHERITED_FD"
BUILTIN_RELAY_ENV = "MCP_CONSOLE_TEST_BUILTIN_RELAY"
SIDEBAND_FD_ENV = "MCP_CONSOLE_SIDEBAND_FD"


def require_closed_server_descriptor(process: str) -> None:
    descriptor = int(os.environ[INHERITED_FD_ENV])
    try:
        os.write(descriptor, b"escaped")
    except OSError as error:
        assert error.errno == errno.EBADF, error
    else:
        raise RuntimeError(f"unlisted server descriptor reached the custom {process}")


def send(endpoint: socket.socket, message: dict[str, Any]) -> None:
    frame = json.dumps(message, separators=(",", ":")).encode("utf-8")
    endpoint.sendall(frame + b"\n")


def run_worker() -> None:
    require_closed_server_descriptor("worker")
    descriptor = int(os.environ.pop(SIDEBAND_FD_ENV))
    os.set_inheritable(descriptor, False)
    endpoint = socket.socket(fileno=descriptor)
    reader = endpoint.makefile("rb")
    send(endpoint, {"kind": "ready"})

    for line in reader:
        message = json.loads(line)
        if message == {"kind": "shutdown"}:
            return
        assert message.get("kind") == "evaluate", message
        send(endpoint, {"kind": "console_output", "data": "closed\n"})
        send(endpoint, {"kind": "completed"})


def run_relay() -> None:
    require_closed_server_descriptor("relay")
    relay = os.environ[BUILTIN_RELAY_ENV]
    os.execv(relay, [relay, "worker-relay", *sys.argv[1:]])


if __name__ == "__main__":
    if SIDEBAND_FD_ENV in os.environ:
        run_worker()
    else:
        run_relay()
