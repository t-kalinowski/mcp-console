#!/usr/bin/env -S UV_CACHE_DIR=${TMPDIR}/uv-cache uv run --script
# /// script
# requires-python = ">=3.11"
# ///

import fcntl
import json
import os
import signal
import time
from enum import StrEnum
from pathlib import Path
from typing import Any, TextIO

READ_FD_ENV = "MCP_CONSOLE_SIDEBAND_READ_FD"
WRITE_FD_ENV = "MCP_CONSOLE_SIDEBAND_WRITE_FD"
LARGE_OUTPUT_SIZE = 2 * 1024 * 1024
PENDING_TEXT_BUDGET = 8 * 1024 * 1024
PNG_1X1 = (
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42Y"
    "AAAAASUVORK5CYII="
)


class ConsoleKind(StrEnum):
    OUTPUT = "console_output"
    DIAGNOSTIC = "console_diagnostic"


def open_sideband(name: str, mode: str) -> TextIO:
    descriptor = int(os.environ.pop(name))
    os.set_inheritable(descriptor, False)
    return os.fdopen(descriptor, mode, encoding="utf-8")


def send(stream: TextIO, message: dict[str, Any]) -> None:
    stream.write(json.dumps(message, separators=(",", ":")) + "\n")
    stream.flush()


def send_batch(stream: TextIO, messages: list[dict[str, Any]]) -> None:
    stream.writelines(
        json.dumps(message, separators=(",", ":")) + "\n" for message in messages
    )
    stream.flush()


def send_output(
    stream: TextIO,
    data: str,
    kind: ConsoleKind = ConsoleKind.OUTPUT,
) -> None:
    send(
        stream,
        {
            "kind": kind,
            "data": data,
        },
    )


def write_all(descriptor: int, data: bytes) -> None:
    remaining = memoryview(data)
    while remaining:
        written = os.write(descriptor, remaining)
        remaining = remaining[written:]


def emit_large_output(descriptor: int, prefix: bytes) -> None:
    write_all(descriptor, prefix + (b"x" * LARGE_OUTPUT_SIZE))
    # Completing a second pipe-sized write proves the preceding payload was read.
    write_all(descriptor, b"y" * LARGE_OUTPUT_SIZE)


def fill_nonblocking(descriptor: int, data: bytes) -> int:
    assert data
    # Guarantee a nonempty tail even when the preceding blocking write refills
    # the pipe before this process can switch the descriptor to nonblocking.
    write_all(descriptor, data[:1])
    flags = fcntl.fcntl(descriptor, fcntl.F_GETFL)
    fcntl.fcntl(descriptor, fcntl.F_SETFL, flags | os.O_NONBLOCK)
    written = 1
    try:
        while written < len(data):
            try:
                written += os.write(descriptor, data[written:])
            except BlockingIOError:
                break
    finally:
        fcntl.fcntl(descriptor, fcntl.F_SETFL, flags)
    assert written > 0
    return written


def emit_background_stderr(root: Path, reader: TextIO, writer: TextIO) -> None:
    while not (root / "zod-release-background-stderr").exists():
        time.sleep(0.01)
    emit_large_output(2, b"zod background stderr\n")
    wait_for_server_to_process_sideband(reader, writer)
    (root / "zod-background-stderr-emitted").touch()


def wait_for_server_to_process_sideband(reader: TextIO, writer: TextIO) -> None:
    """Round-trip through the server after preceding sideband frames."""
    send(
        writer,
        {
            "kind": "resolve_python_version",
            "request": {"constraints": [">=3.11"]},
        },
    )
    response = json.loads(reader.readline())
    assert response["kind"] == "python_version_resolution_failed", response


def configure_startup(root: Path, reader: TextIO, writer: TextIO) -> tuple[bool, bool]:
    control_path = os.environ.get("ZOD_STARTUP_CONTROL")
    if control_path is None:
        return False, False
    control = Path(control_path)
    mode = control.read_text(encoding="utf-8")
    if mode == "fail":
        os._exit(86)
    if mode == "fail with stderr":
        write_all(2, b"zod replacement startup failed\n")
        os._exit(86)
    if mode == "block with detached sideband writer":
        child = os.fork()
        if child == 0:
            os.setsid()
            sideband_writer = os.dup(writer.fileno())
            reader.close()
            writer.close()
            for descriptor in (0, 1, 2):
                os.close(descriptor)
            (root / "zod-detached-startup-sideband-pid").write_text(
                str(os.getpid()),
                encoding="utf-8",
            )
            while True:
                signal.pause()
            os.close(sideband_writer)
        mode = "block"
    if mode in {"block", "block then ready with stdout"}:
        (root / "zod-replacement-waiting-ready").touch()
        release = Path(os.environ["ZOD_STARTUP_RELEASE"])
        while not release.exists():
            time.sleep(0.01)
        mode = "ready with stdout" if mode.endswith("with stdout") else "ready"
    if mode == "ready with stdout":
        write_all(1, b"zod replacement startup ready\n")
        mode = "ready"
    if mode == "ready with callback":
        return True, False
    assert mode == "ready", f"unsupported Zod startup mode: {mode}"
    return False, False


def main() -> None:
    """Run the deterministic sideband fixture until the server shuts it down."""
    reader = open_sideband(READ_FD_ENV, "r")
    writer = open_sideband(WRITE_FD_ENV, "w")
    temporary = Path(os.environ["TMPDIR"])
    if started_marker := os.environ.get("MCP_CONSOLE_TEST_ZOD_STARTED"):
        Path(started_marker).touch()
    received_sigint = False
    sigint_checkpoint = None
    if os.environ.get("ZOD_SIGINT_CHECKPOINT") == "1":
        checkpoint_path = temporary / "zod-sigint-checkpoint"
        os.mkfifo(checkpoint_path)
        sigint_checkpoint = os.open(checkpoint_path, os.O_RDWR | os.O_NONBLOCK)

    def handle_sigint(_signum: int, _frame: object) -> None:
        nonlocal received_sigint
        received_sigint = True
        (temporary / "zod-sigint-received").touch()
        if sigint_checkpoint is not None:
            assert os.write(sigint_checkpoint, b"1") == 1

    signal.signal(signal.SIGINT, handle_sigint)
    if os.environ.get("ZOD_REPORT_PROCESS_GROUP") == "1":
        (temporary / "zod-process-group").write_text(
            str(os.getpgrp()),
            encoding="utf-8",
        )
    startup_callback, startup_ready_sent = configure_startup(temporary, reader, writer)
    if not startup_ready_sent:
        send(writer, {"kind": "ready"})
    if startup_callback:
        send(
            writer,
            {
                "kind": "resolve_python_version",
                "request": {"constraints": [">=3.11"]},
            },
        )
        response = json.loads(reader.readline())
        assert response["kind"] == "python_version_resolution_failed", response
        (temporary / "zod-startup-callback-response").write_text(
            response["message"],
            encoding="utf-8",
        )
    prepared_r_library: str | None = None
    fail_next_r_preparation = False
    emit_output_before_r_preparation_failure = False
    emit_large_output_before_r_preparation_failure = False
    controlled_restart_state = "fresh"
    controlled_restart_evaluations = 0
    queued_message: dict[str, Any] | None = None

    def receive_resolver_response(expected_kind: str) -> dict[str, Any]:
        nonlocal queued_message
        while True:
            response = json.loads(reader.readline())
            if response["kind"] == expected_kind:
                return response
            assert queued_message is None, response
            queued_message = response

    if os.environ.get("ZOD_BLOCK_SIDEBAND_WRITE") == "1":
        reader.read(1)
        Path(os.environ["TMPDIR"], "zod-sideband-blocked").touch()
        while True:
            time.sleep(60)

    while True:
        if queued_message is None:
            line = reader.readline()
            if line == "":
                return
            message = json.loads(line)
        else:
            message = queued_message
            queued_message = None
        message_kind = message["kind"]
        if message_kind == "shutdown":
            return

        if message_kind == "prepare_r":
            assert set(message) == {"kind", "library"}
            if fail_next_r_preparation:
                fail_next_r_preparation = False
                if emit_output_before_r_preparation_failure:
                    emit_output_before_r_preparation_failure = False
                    output = "before failed preparation\n"
                    if emit_large_output_before_r_preparation_failure:
                        emit_large_output_before_r_preparation_failure = False
                        output += "x" * (2 * LARGE_OUTPUT_SIZE)
                    send_output(writer, output)
                    send(
                        writer,
                        {
                            "kind": "image",
                            "data": PNG_1X1,
                            "mime_type": "image/png",
                        },
                    )
                send(
                    writer,
                    {
                        "kind": "r_preparation_failed",
                        "message": "zod rejected R preparation",
                    },
                )
                continue
            prepared_r_library = message["library"]
            send(writer, {"kind": "r_prepared", "library": prepared_r_library})
            continue

        assert message_kind == "evaluate"
        assert set(message) == {"kind", "language", "source"}
        language = message["language"]
        source = message["source"]
        if language in {"python", "sql"}:
            assert source.startswith("echo "), source
            payload = source.removeprefix("echo ")
            for output in (f"zod {language}: ", f"{payload}\n"):
                send_output(writer, output)
            send(writer, {"kind": "completed"})
            continue

        assert language == "r"
        if source == "interrupt":
            (temporary / "zod-interrupt-evaluation-started").touch()
            while not received_sigint:
                time.sleep(0.01)
            received_sigint = False
            send_output(writer, "zod interrupted\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "stall":
            Path(os.environ["TMPDIR"], "zod-stalled").touch()
            while True:
                time.sleep(60)

        if source == "stall accepted relay shutdown":
            relay_pid = os.getpgrp()
            helper = os.fork()
            if helper == 0:
                os.setsid()
                reader.close()
                writer.close()
                for descriptor in (1, 2):
                    os.close(descriptor)
                while os.read(0, 1) != b"":
                    pass
                os.close(0)
                os.kill(relay_pid, signal.SIGSTOP)
                (temporary / "zod-relay-stopped-after-shutdown").touch()
                time.sleep(1.5)
                try:
                    os.kill(relay_pid, signal.SIGCONT)
                except ProcessLookupError:
                    pass
                os._exit(0)
            (temporary / "zod-relay-resume-helper").write_text(
                str(helper),
                encoding="utf-8",
            )
            stopped = temporary / "zod-relay-stopped-after-shutdown"
            while not stopped.exists():
                time.sleep(0.01)
            write_all(1, b"zod output during relay retirement\n")
            while True:
                time.sleep(60)

        if source == "stall with stopped relay":
            relay_pid = os.getpgrp()
            launcher_pid = os.getppid()
            assert relay_pid != launcher_pid
            assert os.getpgid(launcher_pid) == relay_pid
            helper = os.fork()
            if helper == 0:
                os.setsid()
                reader.close()
                writer.close()
                for descriptor in (0, 1, 2):
                    os.close(descriptor)
                os.kill(relay_pid, signal.SIGSTOP)
                (temporary / "zod-relay-stopped").touch()
                while True:
                    signal.pause()
            (temporary / "zod-relay-stop-helper").write_text(
                str(helper),
                encoding="utf-8",
            )
            (temporary / "zod-relay-stop-target").write_text(
                f"{relay_pid} {launcher_pid}",
                encoding="utf-8",
            )
            while True:
                signal.pause()

        if source == "violate protocol":
            send_output(writer, "zod output before protocol failure")
            send(writer, {"kind": "ready"})
            continue

        if source == "violate protocol after stdout":
            emit_large_output(1, b"zod old stdout\n")
            send(writer, {"kind": "ready"})
            continue

        if source == "unexpected input receipt after stdout":
            emit_large_output(1, b"zod unexpected input receipt: ")
            tail_size = fill_nonblocking(1, b"z" * LARGE_OUTPUT_SIZE)
            write_all(1, f"zod expected semantic tail: {tail_size}\n".encode())
            send(writer, {"kind": "input_received"})
            while True:
                signal.pause()

        if source in {
            "malformed sideband after stdout",
            "malformed sideband after stderr",
        }:
            stream = source.removeprefix("malformed sideband after ")
            descriptor = 1 if stream == "stdout" else 2
            emit_large_output(descriptor, f"zod malformed {stream}: ".encode())
            tail_size = fill_nonblocking(descriptor, b"z" * LARGE_OUTPUT_SIZE)
            write_all(
                descriptor,
                f"zod expected {stream} malformed tail: {tail_size}\n".encode(),
            )
            writer.write('{"kind":"console_output","data":}\n')
            writer.flush()
            while True:
                signal.pause()

        if source in {
            "force stop after raw stdout",
            "force stop after raw stderr",
        }:
            stream = source.removeprefix("force stop after raw ")
            descriptor = 1 if stream == "stdout" else 2
            write_all(
                descriptor,
                f"zod retiring {stream}: ".encode() + b"\xe2\x82",
            )
            send(writer, {"kind": "ready"})
            while True:
                signal.pause()

        if source == "exit unexpectedly":
            os._exit(86)

        if source == "overflow console output":
            send_output(writer, "x" * (PENDING_TEXT_BUDGET + 7))
            send(writer, {"kind": "completed"})
            continue

        if source == "exit zero":
            os._exit(0)

        if source == "kill relay and remain live":
            worker_pid = os.getpid()
            launcher_pid = os.getppid()
            relay_pid = os.getpgrp()
            assert len({worker_pid, launcher_pid, relay_pid}) == 3
            assert os.getpgid(launcher_pid) == relay_pid
            send_output(
                writer,
                (
                    f"zod worker pid: {worker_pid}; "
                    f"launcher pid: {launcher_pid}; "
                    f"relay process group: {relay_pid}\n"
                ),
            )
            wait_for_server_to_process_sideband(reader, writer)
            os.kill(relay_pid, signal.SIGKILL)
            while True:
                signal.pause()

        if source == "emit stdout":
            write_all(1, b"zod stdout ")
            for part in ("👩", "🏽", "\u200d", "💻", "\n"):
                write_all(1, part.encode())
            emit_large_output(1, b"")
            send(writer, {"kind": "completed"})
            continue

        if source == "emit terminal redraws":
            write_all(1, b"ordinary stdout\r\r\n")
            write_all(1, b"old\r")
            write_all(1, b"newx\b\n")
            write_all(1, b"old\x1b[")
            write_all(1, b"2Knew\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "emit independent stdout stderr redraws":
            write_all(1, b"\rstdout old")
            write_all(1, b"\rstdout final\n")
            write_all(2, b"\rstderr old")
            write_all(2, b"\rstderr final\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "redraw across polls":
            send_output(writer, "output 10%\r")
            wait_for_server_to_process_sideband(reader, writer)
            (temporary / "zod-redraw-ready").touch()
            while not (temporary / "zod-release-redraw").exists():
                time.sleep(0.01)

            send_output(writer, "output 100%\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "stress redraws":
            payload = "x" * 2048
            send_batch(
                writer,
                [
                    {
                        "kind": ConsoleKind.OUTPUT,
                        "data": f"\rstress {index}: {payload}",
                    }
                    for index in range(100)
                ],
            )
            send_output(writer, "\rstress final\nuseful output\n")
            send(writer, {"kind": "completed"})
            continue

        if source in {"exit after invalid stdout", "exit after invalid stderr"}:
            stream = source.removeprefix("exit after invalid ")
            descriptor = 1 if stream == "stdout" else 2
            emit_large_output(
                descriptor,
                f"zod invalid {stream}: ".encode() + b"\xff trailing: \xe2\x82",
            )
            tail_size = fill_nonblocking(descriptor, b"z" * LARGE_OUTPUT_SIZE)
            write_all(
                descriptor,
                f"zod expected {stream} crash tail: {tail_size}\n".encode(),
            )
            os._exit(86)

        if source == "start background stderr":
            temporary = Path(os.environ["TMPDIR"])
            child = os.fork()
            if child == 0:
                for descriptor in (0, 1):
                    os.close(descriptor)
                emit_background_stderr(temporary, reader, writer)
                os._exit(0)
            (temporary / "zod-background-stderr-pid").write_text(
                str(child),
                encoding="utf-8",
            )
            (temporary / "zod-background-stderr-started").touch()
            send(writer, {"kind": "completed"})
            child_pid, status = os.waitpid(child, 0)
            assert child_pid == child
            assert os.waitstatus_to_exitcode(status) == 0
            continue

        if source == "start background sideband" or source.startswith(
            "start background sideband: "
        ):
            marker = source.removeprefix("start background sideband")
            marker = marker.removeprefix(": ")
            suffix = f"-{marker}" if marker else ""
            child = os.fork()
            if child == 0:
                for descriptor in (0, 1, 2):
                    os.close(descriptor)
                release = temporary / f"zod-release-background-sideband{suffix}"
                while not release.exists():
                    time.sleep(0.01)
                if marker == "combined-requirements-failure":
                    send_output(writer, "idle before failure image\n")
                    send(
                        writer,
                        {
                            "kind": "image",
                            "data": PNG_1X1,
                            "mime_type": "image/png",
                        },
                    )
                    send_output(writer, "idle after failure image\n")
                else:
                    send_output(writer, "zod background sideband\n")
                wait_for_server_to_process_sideband(reader, writer)
                (temporary / f"zod-background-sideband-emitted{suffix}").touch()
                os._exit(0)
            send(writer, {"kind": "completed"})
            (temporary / f"zod-background-sideband-started{suffix}").touch()
            child_pid, status = os.waitpid(child, 0)
            assert child_pid == child
            assert os.waitstatus_to_exitcode(status) == 0
            continue

        if source == "start partial sideband descendant":
            child = os.fork()
            if child == 0:
                os.setsid()
                reader.close()
                for descriptor in (0, 1, 2):
                    os.close(descriptor)
                while True:
                    signal.pause()
            release = temporary / "zod-release-partial-sideband"
            os.mkfifo(release)
            (temporary / "zod-sideband-descendant-pid").write_text(
                str(child),
                encoding="utf-8",
            )
            with release.open("rb", buffering=0) as stream:
                assert stream.read(1) == b"x"
            writer.write('{"kind":"console_output"')
            writer.flush()
            os._exit(86)

        if source == "complete before partial sideband descendant":
            child = os.fork()
            if child == 0:
                os.setsid()
                reader.close()
                for descriptor in (0, 1, 2):
                    os.close(descriptor)
                while True:
                    signal.pause()
            (temporary / "zod-sideband-descendant-pid").write_text(
                str(child),
                encoding="utf-8",
            )
            send(writer, {"kind": "completed"})
            writer.write('{"kind":"console_output"')
            writer.flush()
            continue

        if source == "stall with detached stdin":
            child = os.fork()
            if child == 0:
                os.setsid()
                reader.close()
                writer.close()
                os.close(1)
                os.close(2)
                (temporary / "zod-detached-stdin-pid").write_text(
                    str(os.getpid()),
                    encoding="utf-8",
                )
                (temporary / "zod-detached-stdin-started").touch()
                while True:
                    time.sleep(60)
            while True:
                time.sleep(60)

        if source == "request input":
            send(writer, {"kind": "input_requested", "prompt": "zod> "})
            stdin = input()
            send(writer, {"kind": "input_received"})
            send_output(writer, f"zod stdin: {stdin}\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "language error":
            send_output(
                writer,
                "zod language error\n",
                ConsoleKind.DIAGNOSTIC,
            )
            send(writer, {"kind": "completed"})
            continue

        if source == "wait for stdin close":
            (temporary / "zod-waiting-for-stdin-close").touch()
            assert os.read(0, 1) == b"", "Zod received input instead of stdin EOF"
            emit_large_output(1, b"zod stdin closed\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "set controlled restart state":
            controlled_restart_state = "old"
            (temporary / "zod-controlled-restart-old-worker").write_text(
                str(os.getpid()),
                encoding="utf-8",
            )
            send_output(writer, "zod controlled state: old\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "inspect controlled restart state":
            controlled_restart_evaluations += 1
            with (temporary / "zod-controlled-restart-cell-evaluations").open(
                "a",
                encoding="utf-8",
            ) as evaluations:
                evaluations.write(
                    f"{os.getpid()} {controlled_restart_state} "
                    f"{controlled_restart_evaluations}\n"
                )
            send_output(
                writer,
                f"zod controlled state: {controlled_restart_state}; "
                f"evaluation={controlled_restart_evaluations}\n",
            )
            send(writer, {"kind": "completed"})
            continue

        if source == "request input after timeout":
            temporary = Path(os.environ["TMPDIR"])
            waiting = temporary / "zod-waiting-to-request-input"
            waiting.touch()
            while not (temporary / "zod-release-input-request").exists():
                time.sleep(0.01)
            send_output(writer, "before")
            send(writer, {"kind": "input_requested", "prompt": "late> "})
            send_output(writer, "during")
            send_output(writer, " request\n")
            stdin = input()
            send(writer, {"kind": "input_received"})
            send_output(writer, f"zod stdin: {stdin}\n")
            # Prove that the receipt has cleared the provisional request before
            # the client polls, so the fixed grace cannot add another boundary.
            wait_for_server_to_process_sideband(reader, writer)
            (temporary / "zod-input-received").touch()
            send(writer, {"kind": "completed"})
            continue

        if source == "input without request then request input":
            first = input()
            send(writer, {"kind": "input_requested", "prompt": "second> "})
            second = input()
            send(writer, {"kind": "input_received"})
            send_output(writer, f"zod stdin: {first}|{second}\n")
            send(writer, {"kind": "completed"})
            continue

        if source in {"input without request", "input length without request"}:
            stdin = input()
            output = (
                f"zod stdin: {stdin}\n"
                if source == "input without request"
                else f"zod stdin length: {len(stdin.encode())}\n"
            )
            send_output(writer, output)
            send(writer, {"kind": "completed"})
            continue

        if source == "read fd 0 directly":
            chunks = []
            while not chunks or not chunks[-1].endswith(b"\n"):
                chunk = os.read(0, 3)
                assert chunk, "Zod received stdin EOF before a complete line"
                chunks.append(chunk)
            stdin = b"".join(chunks).decode()
            send_output(writer, f"zod fd 0: {stdin!r}\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "probe sandbox":
            try:
                Path(os.environ["ZOD_SANDBOX_PROBE_PATH"]).write_text(
                    "escaped",
                    encoding="utf-8",
                )
            except PermissionError:
                output = "sandbox blocked host write\n"
            else:
                output = "worker escaped sandbox\n"
            send_output(writer, output)
            send(writer, {"kind": "completed"})
            continue

        if source == "complete silently":
            send(writer, {"kind": "completed"})
            continue

        if source == "request input while idle":
            send_batch(
                writer,
                [
                    {"kind": "completed"},
                    {"kind": "input_requested", "prompt": "idle> "},
                ],
            )
            try:
                value = input()
            except EOFError:
                return
            assert value == "continue"
            send_batch(
                writer,
                [{"kind": "input_received"}],
            )
            continue

        if source == "resolve python while idle":
            send_batch(
                writer,
                [
                    {"kind": "completed"},
                    {
                        "kind": "resolve_python_version",
                        "request": {"constraints": [">=3.11"]},
                    },
                ],
            )
            receive_resolver_response("python_version_resolution_failed")
            requirements = {"packages": ["numpy", "pandas", "idle-package"]}
            send(
                writer,
                {
                    "kind": "resolve_python",
                    "request": {
                        "requirements": requirements,
                        "retained_requirements": requirements,
                    },
                },
            )
            receive_resolver_response("python_resolution_failed")
            continue

        if source == "report runtime R resolution failure":
            send(
                writer,
                {
                    "kind": "resolve_r",
                    "packages": ["blockedresolver"],
                },
            )
            response = receive_resolver_response("r_resolution_failed")
            send_output(
                writer,
                (
                    "zod R resolution failure: "
                    f"{response['failure']}: {response['message']}\n"
                ),
            )
            send(writer, {"kind": "completed"})
            continue

        if source == "report process group":
            send_output(writer, f"zod process group: {os.getpgrp()}\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "report managed R requirement":
            expected_r_library = Path(
                os.environ["MCP_CONSOLE_TEST_R_LIBRARY_IDENTITY"]
            ).read_text(encoding="utf-8")
            configured_r_libraries = [
                library
                for library in os.environ.get("R_LIBS", "").split(os.pathsep)
                if library
            ]
            r_prepared = str(
                prepared_r_library == expected_r_library
                or configured_r_libraries[:1] == [expected_r_library]
            ).lower()
            send_output(writer, f"zod R requirement: prepared={r_prepared}\n")
            send(writer, {"kind": "completed"})
            continue

        if source == "fail next r preparation":
            fail_next_r_preparation = True
            send(writer, {"kind": "completed"})
            continue

        if source == "fail next r preparation after output":
            fail_next_r_preparation = True
            emit_output_before_r_preparation_failure = True
            send(writer, {"kind": "completed"})
            continue

        if source == "fail next r preparation after large output":
            fail_next_r_preparation = True
            emit_output_before_r_preparation_failure = True
            emit_large_output_before_r_preparation_failure = True
            send(writer, {"kind": "completed"})
            continue

        if source == "report managed python activation":
            send(
                writer,
                {
                    "kind": "python_activated",
                    "requirements": {"packages": ["numpy", "pandas"]},
                },
            )
            continue

        if source == "emit console kinds":
            send_output(writer, "zod output\n")
            send_output(writer, "zod diagnostic\n", ConsoleKind.DIAGNOSTIC)
            send(writer, {"kind": "completed"})
            continue

        if source == "emit image":
            send_output(writer, "before image\n")
            send(
                writer,
                {
                    "kind": "image",
                    "data": PNG_1X1,
                    "mime_type": "image/png",
                },
            )
            send_output(writer, "after image\n")
            send(writer, {"kind": "completed"})
            continue

        if source in {
            "emit image before completion",
            "emit output and image before completion",
        }:
            (temporary / "zod-image-evaluation-started").touch()
            while not (temporary / "zod-release-image").exists():
                time.sleep(0.01)
            if source == "emit output and image before completion":
                send_output(writer, "before pending image\n")
            send(
                writer,
                {
                    "kind": "image",
                    "data": PNG_1X1,
                    "mime_type": "image/png",
                },
            )
            if source == "emit output and image before completion":
                send_output(writer, "after pending image\n")
            wait_for_server_to_process_sideband(reader, writer)
            (temporary / "zod-image-processed").touch()
            while not (temporary / "zod-release-image-completion").exists():
                time.sleep(0.01)
            send(writer, {"kind": "completed"})
            continue

        if source == "complete after timeout":
            time.sleep(0.25)
        elif source == "complete after release":
            (temporary / "zod-evaluation-started").touch()
            while not (temporary / "zod-release-evaluation").exists():
                time.sleep(0.01)
        elif source == "output then complete after release":
            send_output(writer, "zod cell output before completion\n")
            wait_for_server_to_process_sideband(reader, writer)
            (temporary / "zod-cell-output-processed").touch()
            while not (temporary / "zod-release-evaluation").exists():
                time.sleep(0.01)
        elif not source.startswith("echo "):
            raise AssertionError(f"unsupported Zod command: {source}")

        payload = source.removeprefix("echo ")
        for output in ("zod: ", f"{payload}\n"):
            send_output(writer, output)
        send(writer, {"kind": "completed"})


if __name__ == "__main__":
    main()
