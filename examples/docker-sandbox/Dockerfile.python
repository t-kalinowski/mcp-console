# Build the wheel-installed Docker Python image first, then pass CONSOLE_IMAGE.
ARG CONSOLE_IMAGE=my-console:python
FROM ${CONSOLE_IMAGE} AS console

# Preserve the provider's shell template and its ordinary VM ownership.
FROM docker.io/docker/sandbox-templates:shell-docker
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/console-python && /opt/console-python/bin/pip install \
    numpy pandas matplotlib duckdb uv
RUN python3 -m venv /opt/console-minimal
# The final VM contains the compatible Linux application, without its native companion.
COPY --from=console /opt/console-python/bin/mcp-console /usr/local/bin/mcp-console
ENV PATH="/opt/console-python/bin:${PATH}"
RUN mkdir -p /workspace && chown agent:agent /workspace
USER agent
RUN /opt/console-python/bin/python -c 'import duckdb; duckdb.connect().install_extension("fts")'
WORKDIR /workspace
