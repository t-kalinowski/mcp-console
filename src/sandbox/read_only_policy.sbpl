; MCP Console macOS read-only Seatbelt policy.
; SPDX-License-Identifier: MIT

(version 1)

; Deny capabilities unless this policy allows them explicitly.
(deny default)

; Commands may read the host filesystem, except for pre-existing terminal
; devices. Regular host-file writes are limited to the private temporary
; directory created for this sandbox invocation. The device and IPC rules below
; provide the additional write operations required by supported runtimes.
; Seatbelt does not revoke capabilities carried by open descriptors. The
; launcher preserves standard streams and explicitly allowed sideband pipes;
; all other inherited descriptors close on exec.
; Seatbelt checks both the existing vnode and the new directory entry for a
; hard-link operation. This permits links within the temporary directory but
; prevents importing an inode from a read-only host path.
(allow file-read*)
(deny file-read*
  (literal "/dev/tty")
  (regex #"^/dev/ttys[0-9]+$"))
(allow file-write*
  (subpath (param "TEMP_DIRECTORY")))

; child processes inherit the policy of their parent
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))

; process-info
(allow process-info* (target same-sandbox))

(allow file-write-data
  (require-all
    (path "/dev/null")
    (vnode-type CHARACTER-DEVICE)))

; Do not allow /dev/stdout, /dev/stderr, or /dev/fd aliases without a real
; package or user workflow that requires reopening inherited stdio by path.
; uv's SystemConfiguration probe writes to /dev/dtracehelper on macOS.
(allow file-write-data
  (require-all
    (path "/dev/dtracehelper")
    (vnode-type CHARACTER-DEVICE)))
; Quarto's wrapper and utilities it spawns perform harmless ioctls on
; /dev/dtracehelper and otherwise fail with EPERM under Seatbelt.
(allow file-ioctl
  (require-all
    (path "/dev/dtracehelper")
    (vnode-type CHARACTER-DEVICE)))

; sysctls permitted.
(allow sysctl-read
  (sysctl-name "hw.activecpu")
  (sysctl-name "hw.busfrequency_compat")
  (sysctl-name "hw.byteorder")
  (sysctl-name "hw.cacheconfig")
  (sysctl-name "hw.cachelinesize_compat")
  (sysctl-name "hw.cpufamily")
  (sysctl-name "hw.cpufrequency_compat")
  (sysctl-name "hw.cputype")
  (sysctl-name "hw.l1dcachesize_compat")
  (sysctl-name "hw.l1icachesize_compat")
  (sysctl-name "hw.l2cachesize_compat")
  (sysctl-name "hw.l3cachesize_compat")
  (sysctl-name "hw.logicalcpu_max")
  (sysctl-name "hw.machine")
  (sysctl-name "hw.model")
  (sysctl-name "hw.memsize")
  (sysctl-name "hw.ncpu")
  (sysctl-name "hw.nperflevels")
  ; Native libraries probe these Apple Silicon feature families at startup.
  (sysctl-name-prefix "hw.optional.arm.")
  (sysctl-name-prefix "hw.optional.armv8_")
  (sysctl-name "hw.packages")
  (sysctl-name "hw.pagesize_compat")
  (sysctl-name "hw.pagesize")
  (sysctl-name "hw.physicalcpu")
  (sysctl-name "hw.physicalcpu_max")
  ; R's parallel::detectCores() uses `sysctl -n hw.logicalcpu` on macOS.
  (sysctl-name "hw.logicalcpu")
  (sysctl-name "hw.cpufrequency")
  (sysctl-name "hw.tbfrequency_compat")
  (sysctl-name "hw.vectorunit")
  ; Quarto uses this value to distinguish Intel from Apple Silicon.
  (sysctl-name "machdep.cpu.brand_string")
  ; Apple Silicon runtime probes use this to detect pointer authentication.
  (sysctl-name "machdep.ptrauth_enabled")
  (sysctl-name "kern.argmax")
  ; The R processx package reads the boot time while loading.
  (sysctl-name "kern.boottime")
  (sysctl-name "kern.hostname")
  (sysctl-name "kern.maxfilesperproc")
  (sysctl-name "kern.maxproc")
  ; Quarto's platform probes invoke sysctl(8) for this value.
  (sysctl-name "kern.ngroups")
  (sysctl-name "kern.osproductversion")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.ostype")
  (sysctl-name "kern.osvariant_status")
  (sysctl-name "kern.osversion")
  (sysctl-name "kern.secure_kernel")
  ; R reads the user stack address while initializing its C stack limit.
  (sysctl-name "kern.usrstack64")
  (sysctl-name "kern.version")
  (sysctl-name "sysctl.proc_cputype")
  ; sysctl -b queries the OID format before returning a binary value.
  (sysctl-name-prefix "sysctl.oidfmt.")
  ; sysctl(8) uses these entries to translate numeric OIDs back to names.
  (sysctl-name-prefix "sysctl.name.")
  (sysctl-name "vm.loadavg")
  (sysctl-name-prefix "hw.perflevel")
  (sysctl-name-prefix "kern.proc.pgrp.")
  (sysctl-name-prefix "kern.proc.pid.")
  (sysctl-name-prefix "net.routetable.")
  ; uv's system-configuration dependency probes these values during startup.
  (sysctl-name "security.mac.lockdown_mode_state")
  (sysctl-name "kern.bootargs")
)

; Allow Java to read some CPU info. This is misclassified as a "write" because
; userspace passes a memory buffer to the sysctl, but conceptually it is a read.
(allow sysctl-write
  (sysctl-name "kern.grade_cputype"))

; IOKit
(allow iokit-open
  (iokit-registry-entry-class "RootDomainUserClient")
)

; Resolve local user and group information.
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
)

; uv uses SystemConfiguration to discover proxy settings.
(allow mach-lookup
  (global-name "com.apple.SystemConfiguration.configd")
)
; uv also probes these macOS services during startup.
(allow mach-lookup
  (global-name "com.apple.logd")
  (global-name "com.apple.system.notification_center")
)

; Intentionally unscoped: arbitrary commands choose their own semaphore names,
; so this generic launcher cannot enforce a per-launch namespace. This supports
; Python multiprocessing but does not isolate semaphores from same-user processes.
(allow ipc-posix-sem)

; Needed for PyTorch/libomp on macOS to register OpenMP runtimes.
(allow ipc-posix-shm-read-data
  ipc-posix-shm-write-create
  ipc-posix-shm-write-unlink
  (ipc-posix-name-regex #"^/__KMP_REGISTERED_LIB_[0-9]+$"))

(allow mach-lookup
  (global-name "com.apple.PowerManagement.control")
)

; Allow commands such as processx to allocate and configure their own PTYs.
; The sandbox extension limits slave access to PTYs created inside this sandbox.
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write* file-ioctl
  (require-all
    (regex #"^/dev/ttys[0-9]+$")
    (extension "com.apple.sandbox.pty")))

; allow readonly user preferences
(allow ipc-posix-shm-read* (ipc-posix-name-prefix "apple.cfprefs."))
(allow mach-lookup
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (local-name "com.apple.cfprefsd.agent"))
(allow user-preference-read)
