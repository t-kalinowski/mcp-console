#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = (
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
)


def fail(message: str) -> None:
    raise SystemExit(f"stage-sandbox-runner: {message}")


def git_output(checkout: Path, *arguments: str) -> str:
    result = subprocess.run(
        ["git", *arguments], cwd=checkout, capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        fail(result.stderr.strip() or result.stdout.strip())
    return result.stdout.strip()


def write_if_changed(path: Path, contents: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if (
        not path.exists()
        or path.read_bytes() != contents
        or stat.S_IMODE(path.stat().st_mode) != mode
    ):
        path.write_bytes(contents)
        path.chmod(mode)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Build and stage the pinned private sandbox runner"
    )
    parser.add_argument(
        "checkout",
        nargs="?",
        type=Path,
        default=os.environ.get("MCP_CONSOLE_SANDBOX_SOURCE"),
    )
    parser.add_argument("--target", choices=TARGETS)
    parser.add_argument("--github-output", type=Path)
    args = parser.parse_args()
    pin = json.loads((ROOT / "sandbox-runner.json").read_text(encoding="utf-8"))
    if not re.fullmatch(r"[0-9a-f]{40}", pin["commit"]):
        fail("sandbox-runner.json must pin a full source commit")
    if args.github_output is not None:
        with args.github_output.open("a", encoding="utf-8") as output:
            for key in ("repository", "commit"):
                output.write(f"{key}={pin[key]}\n")
        return
    if sys.platform not in {"darwin", "linux"}:
        fail(f"building private runner artifacts is unsupported on {sys.platform}")

    checkout = args.checkout
    if checkout is None:
        checkout = ROOT / "target/sandbox-runner-cache" / pin["commit"]
        checkout.mkdir(parents=True, exist_ok=True)
        if not (checkout / ".git").exists():
            git_output(checkout, "init")
        if not (checkout / "codex-rs/Cargo.toml").exists():
            git_output(
                checkout,
                "fetch",
                "--depth",
                "1",
                f"https://github.com/{pin['repository']}.git",
                pin["commit"],
            )
            git_output(checkout, "checkout", "--detach", pin["commit"])
    checkout = checkout.resolve()
    workspace = checkout / "codex-rs"
    if not (workspace / "mcp-console-sandbox/Cargo.toml").is_file():
        fail(f"not a sandbox-runner source checkout: {checkout}")
    head = git_output(checkout, "rev-parse", "HEAD")
    if head != pin["commit"]:
        fail(f"source checkout is at {head}, expected {pin['commit']}")
    if git_output(checkout, "status", "--porcelain", "--untracked-files=all"):
        fail("source checkout is not clean")

    with (workspace / "rust-toolchain.toml").open("rb") as stream:
        channel = tomllib.load(stream)["toolchain"]["channel"]
    toolchain = ["rustup", "run", "--install", channel]
    target = args.target
    if target is None:
        target = subprocess.check_output(
            [*toolchain, "rustc", "--print", "host-tuple"],
            cwd=workspace,
            text=True,
        ).strip()
        if target not in TARGETS:
            fail(f"unsupported native target: {target}")

    # Invoke Cargo on every source build and use its normal freshness checks.
    # Changes to external tools selected through PATH can require cleaning the
    # runner's target directory; see RELEASE.md. No local completed-runner cache
    # bypasses Cargo.
    environment = os.environ.copy()
    environment["CARGO_TARGET_DIR"] = str(workspace / "target")
    binaries = workspace / "target" / target / "release"
    staged_helper = ROOT / "target/sandbox-runner-bwrap" / target / "bwrap"
    if "linux" in target:
        for name in ("CODEX_BWRAP_SOURCE_DIR", "CODEX_SKIP_BWRAP_BUILD"):
            if name in environment:
                fail(
                    f"unset {name}: packaged Bubblewrap must be built from the pinned checkout"
                )
        subprocess.run(
            [
                *toolchain,
                "cargo",
                "build",
                "--locked",
                "--release",
                "-p",
                "codex-bwrap",
                "--bin",
                "bwrap",
                "--target",
                target,
            ],
            cwd=workspace,
            env=environment,
            check=True,
        )
        staged_helper.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(binaries / "bwrap", staged_helper)
        subprocess.run(["strip", "--strip-unneeded", str(staged_helper)], check=True)
        # Bind the runner to the exact stripped executable we ship. Native
        # selection hashes and executes one open descriptor, without a PATH
        # fallback after an integrity failure.
        environment["CODEX_BWRAP_SHA256"] = hashlib.sha256(
            staged_helper.read_bytes()
        ).hexdigest()
    subprocess.run(
        [
            *toolchain,
            "cargo",
            "build",
            "--locked",
            "--release",
            "-p",
            "codex-mcp-console-sandbox",
            "--bin",
            "mcp-console-sandbox",
            "--target",
            target,
        ],
        cwd=workspace,
        env=environment,
        check=True,
    )
    data = ROOT / "wheel-data/data"
    libexec = data / "libexec"
    licenses = data / "share/licenses/mcp-console"
    libexec.mkdir(parents=True, exist_ok=True)
    artifacts = []
    for name in ("mcp-console-sandbox", *(["bwrap"] if "linux" in target else [])):
        # Strip a temporary copy so unchanged Cargo inputs keep their mtimes.
        staged = libexec / f".{name}"
        shutil.copyfile(staged_helper if name == "bwrap" else binaries / name, staged)
        staged.chmod(0o755)
        # Preserve the symbolicateable original in Cargo's build directory.
        strip = (
            ["strip", "--strip-unneeded"]
            if "linux" in target
            else ["xcrun", "strip", "-S", "-x"]
        )
        if name != "bwrap":
            subprocess.run([*strip, str(staged)], check=True)
        destination = libexec / name
        write_if_changed(destination, staged.read_bytes(), 0o755)
        staged.unlink()
        artifacts.append(destination)
    notices = [(checkout / name, name) for name in ("LICENSE", "NOTICE")]
    if "linux" in target:
        notices.append((workspace / "vendor/bubblewrap/COPYING", "bubblewrap-COPYING"))
        header, terminator, _ = (
            (workspace / "vendor/bubblewrap/bubblewrap.c")
            .read_text(encoding="utf-8")
            .partition("*/")
        )
        if not terminator or not header.startswith("/*") or "Copyright" not in header:
            fail("expected the pinned Bubblewrap copyright header in bubblewrap.c")
        notice = licenses / "bubblewrap-NOTICE"
        write_if_changed(
            notice,
            (
                "Bubblewrap companion\n\n"
                f"Source archive: https://github.com/{pin['repository']}/archive/{head}.tar.gz\n"
                "C source: codex-rs/vendor/bubblewrap\n"
                "Build integration: codex-rs/bwrap\n"
                "License text: bubblewrap-COPYING\n"
                f"Rust toolchain: {channel} (codex-rs/rust-toolchain.toml)\n\n"
                f"{header}*/\n"
            ).encode(),
            0o644,
        )
        artifacts.append(notice)

        # Inspect the shipped ELF, not pkg-config's requested linkage. The pinned
        # build script emits unqualified rustc-link-lib directives for libcap.
        dynamic = subprocess.check_output(
            ["readelf", "-d", "-W", str(staged_helper)],
            text=True,
            env=environment | {"LC_ALL": "C"},
        )
        needed = sorted(re.findall(r"\(NEEDED\).*\[([^]]+)\]", dynamic))
        libcap_linkage = (
            "dynamic"
            if any(name.startswith("libcap.so.") for name in needed)
            else "static"
        )
        if libcap_linkage == "static":
            symbols = subprocess.check_output(
                ["readelf", "-s", "-W", str(binaries / "bwrap")],
                text=True,
                env=environment | {"LC_ALL": "C"},
            )
            if not re.search(r"\bFUNC\s+\w+\s+\w+\s+\d+\s+cap_get_proc\b", symbols):
                fail("cannot establish libcap linkage from the helper ELF")
            notice = environment.get("MCP_CONSOLE_LIBCAP_NOTICE")
            if (
                not notice
                or not Path(notice).is_file()
                or not Path(notice).read_bytes().strip()
            ):
                fail(
                    "static libcap requires MCP_CONSOLE_LIBCAP_NOTICE pointing to its redistribution notice"
                )
            notices.append((Path(notice), "libcap-NOTICE"))
        provenance = licenses / "bubblewrap-SOURCE.json"
        write_if_changed(
            provenance,
            (
                json.dumps(
                    {
                        "source_repository": pin["repository"],
                        "source_revision": head,
                        "source_directory": "codex-rs/vendor/bubblewrap",
                        "build_script": "codex-rs/bwrap/build.rs",
                        "wrapper_directory": "codex-rs/bwrap",
                        "sha256": environment["CODEX_BWRAP_SHA256"],
                        "elf_needed": needed,
                        "libcap_linkage": libcap_linkage,
                    },
                    indent=2,
                )
                + "\n"
            ).encode(),
            0o644,
        )
        artifacts.append(provenance)
    for source, name in notices:
        destination = licenses / name
        write_if_changed(destination, source.read_bytes(), 0o644)
        artifacts.append(destination)
    # Reconcile the owned trees, including artifacts from a different target.
    for name in ("libexec", "share"):
        for path in sorted((data / name).rglob("*"), reverse=True):
            if path.is_dir():
                if not any(path.iterdir()):
                    path.rmdir()
            elif path not in artifacts:
                path.unlink()
    build_record = ROOT / "target/sandbox-runner-build.json"
    write_if_changed(
        build_record,
        (
            json.dumps(
                {
                    "source_revision": head,
                    "target": target,
                    "artifacts": {
                        path.name: hashlib.sha256(path.read_bytes()).hexdigest()
                        for path in artifacts
                    },
                },
                indent=2,
            )
            + "\n"
        ).encode("utf-8"),
        0o644,
    )


if __name__ == "__main__":
    main()
