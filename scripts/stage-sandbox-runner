#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = ("aarch64-apple-darwin", "x86_64-apple-darwin")


def fail(message: str) -> None:
    raise SystemExit(f"stage-sandbox-runner: {message}")


def git_output(checkout: Path, *arguments: str) -> str:
    result = subprocess.run(
        ["git", *arguments], cwd=checkout, capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        fail(result.stderr.strip() or result.stdout.strip())
    return result.stdout.strip()


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Build and stage the pinned private sandbox runner"
    )
    parser.add_argument(
        "checkout",
        nargs="?",
        type=Path,
        default=os.environ.get("MCP_CONSOLE_SANDBOX_SOURCE"),
    )
    parser.add_argument("--target", choices=TARGETS)
    parser.add_argument("--github-output", type=Path)
    parser.add_argument(
        "--cache-dir", type=Path, default=ROOT / "target/sandbox-runner-cache"
    )
    parser.add_argument(
        "--output-dir", type=Path, default=ROOT / "target/sandbox-runner"
    )
    args = parser.parse_args()
    pin = json.loads((ROOT / "sandbox-runner.json").read_text(encoding="utf-8"))
    if not re.fullmatch(r"[0-9a-f]{40}", pin["commit"]):
        fail("sandbox-runner.json must pin a full source commit")
    if args.github_output is not None:
        with args.github_output.open("a", encoding="utf-8") as output:
            for key in ("repository", "commit", "rust_toolchain"):
                output.write(f"{key}={pin[key]}\n")
        return
    if sys.platform != "darwin":
        fail(f"building private runner artifacts is unsupported on {sys.platform}")

    args.cache_dir.mkdir(parents=True, exist_ok=True)
    # Multiple Cargo profiles can request the same source build concurrently.
    with (args.cache_dir / f"{pin['commit']}.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        checkout = args.checkout
        if checkout is None:
            checkout = args.cache_dir / pin["commit"]
            checkout.mkdir(exist_ok=True)
            if not (checkout / ".git").exists():
                git_output(checkout, "init")
            if not (checkout / "codex-rs/Cargo.toml").exists():
                git_output(
                    checkout,
                    "fetch",
                    "--depth",
                    "1",
                    f"https://github.com/{pin['repository']}.git",
                    pin["commit"],
                )
                git_output(checkout, "checkout", "--detach", pin["commit"])
        build(checkout.resolve(), args.output_dir.resolve(), args.target, pin)


def build(
    checkout: Path, output: Path, target: str | None, pin: dict[str, object]
) -> None:
    workspace = checkout / "codex-rs"
    if not (workspace / "mcp-console-sandbox" / "Cargo.toml").is_file():
        fail(f"not a sandbox-runner source checkout: {checkout}")
    head = git_output(checkout, "rev-parse", "HEAD")
    if head != pin["commit"]:
        fail(f"source checkout is at {head}, expected {pin['commit']}")
    if git_output(checkout, "status", "--porcelain", "--untracked-files=all"):
        fail("source checkout is not clean")

    toolchain = ["rustup", "run", "--install", str(pin["rust_toolchain"])]
    if target is None:
        target = subprocess.run(
            [*toolchain, "rustc", "--print", "host-tuple"],
            cwd=workspace,
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        if target not in TARGETS:
            fail(f"unsupported native target: {target}")

    environment = os.environ.copy()
    environment["CARGO_TARGET_DIR"] = str(workspace / "target")
    # Build independently of the outer Cargo's jobserver, compiler, and Clippy
    # wrapper. rustup must select the runner's pinned compiler and Cargo.
    for name in (
        "CARGO_MAKEFLAGS",
        "MAKEFLAGS",
        "MFLAGS",
        "CARGO_BUILD_BUILD_DIR",
        "RUSTC",
        "RUSTDOC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "RUSTFLAGS",
        "CARGO_ENCODED_RUSTFLAGS",
        "CLIPPY_ARGS",
    ):
        environment.pop(name, None)
    command = [
        *toolchain,
        "cargo",
        "build",
        "--locked",
        "--release",
        "-p",
        "codex-mcp-console-sandbox",
        "--bin",
        "mcp-console-sandbox",
        "--target",
        target,
    ]
    result = subprocess.run(command, cwd=workspace, env=environment, check=False)
    if result.returncode != 0:
        fail(f"runner build failed with status {result.returncode}")
    runner = workspace / "target" / target / "release" / "mcp-console-sandbox"
    digest = hashlib.sha256(runner.read_bytes()).hexdigest()

    output.mkdir(parents=True, exist_ok=True)
    staged_runner = output / "mcp-console-sandbox"
    shutil.copyfile(runner, staged_runner)
    staged_runner.chmod(0o755)
    for name in ("LICENSE", "NOTICE"):
        destination = output / name
        shutil.copyfile(checkout / name, destination)
        destination.chmod(0o644)
    (output / "build.json").write_text(
        json.dumps(
            {"source_revision": head, "target": target, "sha256": digest}, indent=2
        )
        + "\n",
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
