#!/usr/bin/env python3
"""Check marked R/Python programs in Python fixtures without evaluating them."""

import argparse
import ast
import io
import subprocess
import tempfile
import textwrap
import tokenize
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="*", type=Path, default=[ROOT / "tests"])
    options = parser.parse_args()
    paths = set()
    for path in options.paths:
        if not path.exists():
            parser.error(f"path does not exist: {path}")
        paths.update(path.rglob("*.py") if path.is_dir() else [path])
    errors = []
    r_programs = []
    parsed = dynamic = skipped = 0
    for path in sorted(paths):
        source = path.read_text()
        try:
            tree = ast.parse(source, filename=str(path))
        except SyntaxError as error:
            errors.append(f"{path}:{error.lineno}: fixture syntax: {error.msg}")
            continue
        lines = source.splitlines()
        comments = {
            token.start[0]: token.string
            for token in tokenize.generate_tokens(io.StringIO(source).readline)
            if token.type == tokenize.COMMENT
        }
        parents = {
            child: parent
            for parent in ast.walk(tree)
            for child in ast.iter_child_nodes(parent)
        }
        for node in ast.walk(tree):
            if not (
                isinstance(node, ast.JoinedStr)
                or isinstance(node, ast.Constant)
                and isinstance(node.value, str)
            ):
                continue
            if (
                isinstance(parents.get(node), ast.JoinedStr)
                or node.lineno == node.end_lineno
            ):
                continue
            parts = node.values if isinstance(node, ast.JoinedStr) else [node]
            if not any(
                isinstance(part, ast.Constant) and "\n" in part.value for part in parts
            ):
                continue
            ancestors = [node]
            while ancestors[-1] in parents and not isinstance(ancestors[-1], ast.stmt):
                ancestors.append(parents[ancestors[-1]])
            language = wanted = skip = None
            code_call = None
            for ancestor in ancestors:
                if isinstance(ancestor, ast.keyword) and ancestor.arg in {
                    "r",
                    "python",
                }:
                    wanted = ancestor.arg
                if wanted is None and isinstance(ancestor, (ast.Assign, ast.AnnAssign)):
                    targets = (
                        ancestor.targets
                        if isinstance(ancestor, ast.Assign)
                        else [ancestor.target]
                    )
                    wanted = next(
                        (
                            t.id
                            for t in targets
                            if isinstance(t, ast.Name) and t.id in {"r", "python"}
                        ),
                        wanted,
                    )
                if (
                    isinstance(ancestor, ast.Call)
                    and isinstance(ancestor.func, ast.Name)
                    and ancestor.func.id == "code"
                ):
                    code_call = ancestor
                if language is None:
                    directive = comments.get(ancestor.lineno - 1, "")
                    if directive in {"# fmt: r", "# fmt: python"}:
                        language = directive.removeprefix("# fmt: ")
                        marker = comments.get(ancestor.lineno - 2, "")
                        if marker.startswith("# syntax: skip"):
                            skip = marker.removeprefix("# syntax: skip").strip()
            location = f"{path}:{node.lineno}"
            if language is None:
                if wanted:
                    errors.append(f"{location}: missing # fmt: {wanted}")
                continue
            if wanted is not None and language != wanted:
                errors.append(
                    f"{location}: expected # fmt: {wanted}; found # fmt: {language}"
                )
                continue
            if code_call is not None:
                line = lines[code_call.lineno - 1]
                indentation = len(line) - len(line.lstrip()) + 4
                payload = [
                    line
                    for line in lines[node.lineno : node.end_lineno - 1]
                    if line.strip()
                ]
                closing = lines[node.end_lineno - 1]
                if (
                    payload
                    and min(len(line) - len(line.lstrip()) for line in payload)
                    != indentation
                ) or len(closing) - len(closing.lstrip()) != indentation:
                    errors.append(
                        f"{location}: indent code() payload and closing delimiter by four spaces"
                    )
            if skip is not None:
                if not skip:
                    errors.append(f"{location}: syntax skip requires a reason")
                skipped += 1
            elif isinstance(node, ast.JoinedStr):
                dynamic += 1
            else:
                program = textwrap.dedent(node.value).removeprefix("\n")
                if language == "r":
                    r_programs.append((location, program))
                else:
                    try:
                        compile(program, str(path), "exec", dont_inherit=True)
                        parsed += 1
                    except SyntaxError as error:
                        errors.append(
                            f"{location}: python syntax: {error.msg} (program line {error.lineno})"
                        )
    if r_programs:
        with tempfile.TemporaryDirectory() as temporary:
            files = []
            for index, (_, program) in enumerate(r_programs):
                path = Path(temporary) / str(index)
                path.write_text(program)
                files.append(str(path))
            result = subprocess.run(
                ["Rscript", "--vanilla", "-e", R_PARSE, *files],
                capture_output=True,
                text=True,
                check=True,
            )
            failures = result.stdout.splitlines()
            parsed += len(files) - len(failures)
            for failure in failures:
                index, message = failure.split("\t", 1)
                errors.append(f"{r_programs[int(index)][0]}: r syntax: {message}")
    for error in errors:
        print(error)
    print(
        f"fixtures: {parsed} parsed; {dynamic} dynamic template(s); {skipped} intentional syntax skip(s); {len(errors)} error(s)"
    )
    raise SystemExit(bool(errors))


# fmt: r
R_PARSE = r"""
args <- commandArgs(TRUE)
for (i in seq_along(args)) {
  tryCatch(
    parse(file = args[[i]]),
    error = function(e) {
      cat(i - 1L, gsub("[\r\n]+", " ", conditionMessage(e)), sep = "\t")
      cat("\n")
    }
  )
}
"""

if __name__ == "__main__":
    main()
