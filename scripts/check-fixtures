#!/usr/bin/env python3
"""Check marked R/Python programs in Python fixtures without evaluating them."""

import argparse
import ast
import io
import os
import re
import subprocess
import tempfile
import textwrap
import tokenize
from collections.abc import Iterator
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def program_nodes(node: ast.AST) -> Iterator[ast.AST]:
    yield node
    # Interpolation expressions belong to the template, not separate programs.
    if not isinstance(node, ast.JoinedStr):
        for child in ast.iter_child_nodes(node):
            yield from program_nodes(child)


def program_expression(node: ast.AST) -> tuple[ast.AST, ast.Call | None]:
    # Only direct code() payloads have statically checked layout. Do not descend
    # into arbitrary dynamic composition to infer more program boundaries.
    if isinstance(node, (ast.Assign, ast.AnnAssign, ast.keyword, ast.Expr)):
        node = node.value
    if (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "code"
        and len(node.args) == 1
        and not node.keywords
    ):
        return node.args[0], node
    return node, None


def declared_language(node: ast.AST) -> str | None:
    if isinstance(node, ast.keyword):
        return node.arg if node.arg in {"r", "python"} else None
    if isinstance(node, (ast.Assign, ast.AnnAssign)):
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        return next(
            (
                target.id
                for target in targets
                if isinstance(target, ast.Name) and target.id in {"r", "python"}
            ),
            None,
        )
    return None


def is_literal(node: ast.AST) -> bool:
    return isinstance(node, ast.JoinedStr) or (
        isinstance(node, ast.Constant) and isinstance(node.value, str)
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="*", type=Path, default=[ROOT / "tests"])
    options = parser.parse_args()
    paths = set()
    for path in options.paths:
        if not path.exists():
            parser.error(f"path does not exist: {path}")
        paths.update(path.rglob("*.py") if path.is_dir() else [path])
    errors = []
    r_programs = []
    parsed = dynamic = skipped = 0
    for path in sorted(paths):
        source = path.read_text()
        try:
            tree = ast.parse(source, filename=str(path))
        except SyntaxError as error:
            errors.append(f"{path}:{error.lineno}: fixture syntax: {error.msg}")
            continue
        lines = source.splitlines()
        comments = {
            token.start[0]: token.string
            for token in tokenize.generate_tokens(io.StringIO(source).readline)
            if token.type == tokenize.COMMENT
        }
        nodes = list(program_nodes(tree))
        anchors = {}
        programs = {}
        for node in nodes:
            line = getattr(node, "lineno", None)
            if line is not None and (
                line not in anchors or node.col_offset < anchors[line].col_offset
            ):
                anchors[line] = node
            wanted = declared_language(node)
            if wanted is not None:
                expression, code_call = program_expression(node)
                if is_literal(expression):
                    programs[expression] = (code_call, wanted, None, None)
        for line, directive in comments.items():
            if directive not in {"# fmt: r", "# fmt: python"}:
                continue
            anchor = anchors.get(line + 1)
            if anchor is None:
                errors.append(
                    f"{path}:{line}: formatting directive must precede a program"
                )
                continue
            expression, code_call = program_expression(anchor)
            wanted = programs.get(expression, (None, declared_language(anchor)))[1]
            marker = re.fullmatch(
                r"# syntax: skip(?:\s+(.*))?", comments.get(line - 1, "")
            )
            skip = (marker[1] or "").strip() if marker else None
            programs[expression] = (
                code_call,
                wanted,
                directive.removeprefix("# fmt: "),
                skip,
            )
        for node, (code_call, wanted, language, skip) in programs.items():
            # The directive selects one complete expression. Transformations and
            # assembled values need their public case, not partial evaluation.
            parts = (
                (node.values if isinstance(node, ast.JoinedStr) else [node])
                if is_literal(node)
                else None
            )
            if parts is not None and not any(
                isinstance(part, ast.Constant) and "\n" in part.value for part in parts
            ):
                continue
            location = f"{path}:{node.lineno}"
            if language is None:
                if wanted:
                    errors.append(f"{location}: missing # fmt: {wanted}")
                continue
            if wanted is not None and language != wanted:
                errors.append(
                    f"{location}: expected # fmt: {wanted}; found # fmt: {language}"
                )
                continue
            if code_call is not None and node.lineno != node.end_lineno:
                line = lines[code_call.lineno - 1]
                indentation = len(line) - len(line.lstrip()) + 4
                payload = [
                    line
                    for line in lines[node.lineno : node.end_lineno - 1]
                    if line.strip()
                ]
                closing = lines[node.end_lineno - 1].encode()[: node.end_col_offset - 3]
                if (
                    payload
                    and min(len(line) - len(line.lstrip()) for line in payload)
                    != indentation
                ) or closing != b" " * indentation:
                    errors.append(
                        f"{location}: indent code() payload and closing delimiter by four spaces"
                    )
            if skip is not None:
                if not skip:
                    errors.append(f"{location}: syntax skip requires a reason")
                skipped += 1
            elif parts is None or any(
                isinstance(part, ast.FormattedValue) for part in parts
            ):
                dynamic += 1
            else:
                program = "".join(part.value for part in parts)
                if code_call is not None or wanted is None:
                    program = textwrap.dedent(program).removeprefix("\n")
                if language == "r":
                    r_programs.append((location, program))
                else:
                    try:
                        compile(program, str(path), "exec", dont_inherit=True)
                        parsed += 1
                    except SyntaxError as error:
                        errors.append(
                            f"{location}: python syntax: {error.msg} (program line {error.lineno})"
                        )
    if r_programs:
        with tempfile.TemporaryDirectory() as temporary:
            files = []
            for index, (_, program) in enumerate(r_programs):
                path = Path(temporary) / str(index)
                path.write_text(program)
                files.append(str(path))
            r_home = os.environ.get("R_HOME")
            rscript = str(Path(r_home) / "bin/Rscript") if r_home else "Rscript"
            result = subprocess.run(
                [rscript, "--vanilla", "-e", R_PARSE, *files],
                capture_output=True,
                text=True,
                check=True,
            )
            failures = result.stdout.splitlines()
            parsed += len(files) - len(failures)
            for failure in failures:
                index, message = failure.split("\t", 1)
                errors.append(f"{r_programs[int(index)][0]}: r syntax: {message}")
    for error in errors:
        print(error)
    print(
        f"fixtures: {parsed} parsed; {dynamic} dynamic template(s); {skipped} intentional syntax skip(s); {len(errors)} error(s)"
    )
    raise SystemExit(bool(errors))


# fmt: r
R_PARSE = r"""
args <- commandArgs(TRUE)
for (i in seq_along(args)) {
  tryCatch(
    parse(file = args[[i]]),
    error = function(e) {
      cat(i - 1L, gsub("[\r\n]+", " ", conditionMessage(e)), sep = "\t")
      cat("\n")
    }
  )
}
"""

if __name__ == "__main__":
    main()
