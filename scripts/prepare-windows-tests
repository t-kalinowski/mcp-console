#!/usr/bin/env python3
"""Provision Windows sandbox acceptance and export its verified CI environment."""

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--binary",
    type=Path,
    default=Path(__file__).resolve().parent.parent / "target/debug/mcp-console.exe",
)
parser.add_argument("--state-dir", type=Path, required=True)
parser.add_argument("--github-env", type=Path, required=True)
parser.add_argument(
    "--require-configured",
    action="store_true",
    help="require existing sandbox setup instead of provisioning accounts",
)
parser.add_argument(
    "--read-root",
    type=Path,
    action="append",
    default=[],
    help="grant the provisioned sandbox accounts read/execute access to a test asset directory",
)
options = parser.parse_args()
if os.name != "nt":
    parser.error("Windows sandbox preparation requires Windows")
if not options.state_dir.is_absolute():
    parser.error("--state-dir must be absolute")
for path in options.read_root:
    if not path.is_absolute() or not path.is_dir():
        parser.error(f"--read-root must select an existing absolute directory: {path}")
read_roots = tuple(dict.fromkeys(path.resolve() for path in options.read_root))

r_home = Path(
    os.environ.get("R_HOME")
    or subprocess.check_output(
        [shutil.which("R") or "R", "RHOME"], text=True, timeout=30
    ).strip()
)
if not r_home.is_absolute() or not (r_home / "bin/R.exe").is_file():
    raise SystemExit(f"R_HOME does not select a Windows R installation: {r_home}")

command = [str(options.binary), "sandbox-setup", "--state-dir", str(options.state_dir)]


def readiness():
    result = subprocess.run(
        [*command, "--status"], capture_output=True, text=True, timeout=30
    )
    sys.stderr.write(result.stderr)
    if result.returncode not in (0, 1):
        result.check_returncode()
    status = json.loads(result.stdout)
    if status["configured"]:
        result.check_returncode()
    return status


status = readiness()
if not status["configured"]:
    if options.require_configured:
        raise SystemExit("Windows sandbox setup is not ready")
    subprocess.run(command, check=True, timeout=300)
    status = readiness()
if not status["configured"] or not status["helpers_available"]:
    raise SystemExit("Windows sandbox setup is not ready")

for path in read_roots:
    subprocess.run(
        [
            shutil.which("icacls") or "icacls",
            str(path),
            "/grant",
            f"{status['offline_account']}:(OI)(CI)RX",
            f"{status['online_account']}:(OI)(CI)RX",
        ],
        check=True,
    )

with options.github_env.open("a", encoding="utf-8", newline="\n") as exported:
    exported.write(f"R_HOME={r_home}\n")
    exported.write(f"MCP_CONSOLE_TEST_WINDOWS_STATE_DIR={options.state_dir}\n")
print(f"Windows sandbox ready: {options.state_dir}")
