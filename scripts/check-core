#!/bin/sh

set -eu

python3 scripts/validate_runtime_sources.py
python3 tests/release.py
uv run --script tests/transcript_runner.py
uv run --script tests/mcp_client.py
python3 tests/architecture.py
cargo fmt --all --check
cargo clippy --all-targets --all-features -- -D warnings
cargo test --all-targets --all-features
