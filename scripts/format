#!/bin/sh

set -eu

cd "${0%/*}/.."

if command -v uv >/dev/null 2>&1; then
    uv format
fi

if command -v yamark >/dev/null 2>&1; then
    yamark format --wrap sentence
fi

if command -v cargo >/dev/null 2>&1; then
    cargo fmt --all
fi

if command -v air >/dev/null 2>&1; then
    air format .
fi
