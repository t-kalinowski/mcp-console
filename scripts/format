#!/bin/sh

set -eu

cd "${0%/*}/.."

strict=0
case "${1-}" in
    '') ;;
    --strict) strict=1; shift ;;
    *) echo 'usage: scripts/format [--strict]' >&2; exit 2 ;;
esac
[ "$#" -eq 0 ] || { echo 'usage: scripts/format [--strict]' >&2; exit 2; }
failed=0

format() {
    name=$1
    shift
    if "$@"; then
        echo "$name: ok"
    else
        status=$?
        echo "$name: failed ($status)"
        failed=1
    fi
}

format ruff ruff format
format yamark yamark format --wrap sentence
format rustfmt cargo fmt --all
format air air format .
format fixtures scripts/check-fixtures

if [ "$strict" -eq 1 ]; then
    exit "$failed"
fi
