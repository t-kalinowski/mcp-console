#!/usr/bin/env python3
"""Inventory local development prerequisites and existing test capabilities."""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def probe(*command: str) -> str:
    result = subprocess.run(
        command, cwd=ROOT, capture_output=True, text=True, timeout=10, check=True
    )
    return (result.stdout + result.stderr).strip()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    options = parser.parse_args()
    tools = {}
    missing = []
    for name in ("git", "uv", "cargo", "rustup", "R", "Rscript"):
        path = shutil.which(name)
        tools[name] = {"path": path, "version": None, "error": None}
        if path:
            try:
                tools[name]["version"] = probe(path, "--version").splitlines()[0]
            except subprocess.CalledProcessError as error:
                tools[name]["error"] = (error.stdout + error.stderr).strip()
            except (OSError, subprocess.TimeoutExpired) as error:
                tools[name]["error"] = str(error)
        if tools[name]["version"] is None:
            missing.append(name)
    companion = json.loads(
        probe(sys.executable, str(ROOT / "scripts/stage-sandbox-runner"), "--describe")
    )
    executable = ROOT / "target/release/mcp-console"
    artifacts = {
        str(path): path.is_file()
        for path in (
            executable,
            ROOT / "wheel-data/data/libexec/mcp-console-sandbox",
            ROOT / "target/libexec/mcp-console-sandbox",
        )
    }

    # Reuse public-test probes only; never call provider provisioning fixtures.
    sys.path.insert(0, str(ROOT / "tests"))
    from support.docker import DOCKER
    from support.docker_sandbox import DOCKER_SANDBOX
    from support.ssh_external import EXTERNAL_SSH, HOST
    from support.requirements import (
        FRESH_PROCFS,
        LANDLOCK,
        NESTED_PROCFS,
        PROCESS_EVENTS,
    )

    providers = {
        name: {
            "status": "available" if requirement.available else "skip",
            "reason": None if requirement.available else requirement.reason,
        }
        for name, requirement in {
            "docker": DOCKER,
            "docker_sandbox": DOCKER_SANDBOX,
            "external_ssh": EXTERNAL_SSH,
        }.items()
    }
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
    report = {
        "checkout": str(ROOT),
        "revision": probe("git", "rev-parse", "HEAD")
        if tools["git"]["version"] and (ROOT / ".git").exists()
        else None,
        "executable": {
            "development": str(executable),
            "present": executable.is_file(),
            "on_path": shutil.which("mcp-console"),
        },
        "companion": companion,
        "artifacts": artifacts,
        "tools": tools,
        "runtime": {
            "command_python": sys.executable,
            "command_python_version": sys.version.split()[0],
            "python_selection": os.environ.get("RETICULATE_PYTHON")
            or "managed at worker startup",
            "r_home": os.environ.get("R_HOME")
            or (probe("R", "RHOME") if tools["R"]["version"] else None),
            "console_toolchain": probe("rustup", "show", "active-toolchain")
            if tools["rustup"]["version"] and tools["cargo"]["version"]
            else None,
        },
        "providers": providers,
        "external_ssh_host": HOST,
        "host_capabilities": {
            item.name: {"available": item.available, "reason": item.reason}
            for item in (PROCESS_EVENTS, LANDLOCK, NESTED_PROCFS, FRESH_PROCFS)
        },
        "caches": {
            "checkout_build": str(ROOT / "target"),
            "runner_source": companion["source_checkout"],
            "runner_build": companion["build_directory"],
            "wheel_staging": companion["staging_directory"],
            "cargo_home": os.environ.get("CARGO_HOME", str(Path.home() / ".cargo")),
            "uv": probe("uv", "cache", "dir") if tools["uv"]["version"] else None,
            "host_budget": str(cache / "mcp-console/checks"),
        },
        "required_missing": missing,
    }
    if options.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"Checkout: {ROOT}\nRevision: {report['revision']}")
        print(
            f"Development executable: {executable} ({'present' if executable.is_file() else 'missing'})"
        )
        print(f"PATH executable: {report['executable']['on_path']}")
        print(
            f"Companion pin: {companion['pin']['commit']}\nStaged revision: {companion['staged_revision']}"
        )
        print(f"Staged target: {companion['staged_target']}")
        print(f"Companion toolchain: {companion['source_toolchain']}")
        for path, present in artifacts.items():
            print(f"Artifact: {path} ({'present' if present else 'missing'})")
        for name, value in report["runtime"].items():
            print(f"{name}: {value}")
        for name, value in tools.items():
            print(f"Required {name}: {value['version'] or 'MISSING'} ({value['path']})")
            if value["error"]:
                print(value["error"])
        for name, item in providers.items():
            print(
                f"Optional {name}: {item['status']}"
                + (f"; {item['reason']}" if item["reason"] else "")
            )
        for name, item in report["host_capabilities"].items():
            print(
                f"Host {name}: {'available' if item['available'] else 'skip; ' + item['reason']}"
            )
        for name, path in report["caches"].items():
            print(f"Cache {name}: {path}")
    raise SystemExit(bool(missing))


if __name__ == "__main__":
    main()
